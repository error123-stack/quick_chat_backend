PORT=5000
NODE_ENV=production

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

JWT_SECRET=your_jwt_secret_key_here_change_in_production
SESSION_SECRET=your_session_secret_key_here_change_in_production

FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost:5000
OAUTH_SUCCESS_REDIRECT=http://localhost

SOCKET_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

MAIL_FROM=noreply@yourdomain.com
MAIL_REPLY_TO=support@yourdomain.com

RESEND_API_KEY=your_resend_api_key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT=15000
SMTP_GREETING_TIMEOUT=15000
SMTP_SOCKET_TIMEOUT=20000
SMTP_DNS_TIMEOUT=10000
SMTP_POOL=false
SMTP_AUTH_TYPE=login
SMTP_SERVICE=Gmail

ALLOW_VERIFICATION_LINK_FALLBACK=true
ALLOW_RESET_LINK_FALLBACK=true
